# ─── YouTube Channels (comma-separated channel URLs or handles) ───
YOUTUBE_CHANNELS="@channelhandle1,@channelhandle2,UCxxxxxx"

# ─── How many videos to fetch per channel (default: 3) ───
VIDEO_LIMIT=3

# ─── Max clips generated per video (ceiling, default: 6) ───
# Keep low: many near-duplicate clips from one video trigger YouTube's
# mass-produced content suppression and cannibalize each other.
MAX_CLIPS_PER_VIDEO=6

# ─── Minimum viralScore (1-10) a clip needs to be published (default: 7) ───
MIN_VIRAL_SCORE=7

# ─── Destination channel handle for the viral feedback loop (optional) ───
# When set (or derivable from the managed channel id), top/flop titles from the
# channel's own history are injected into the AI prompts.
# CHANNEL_HANDLE=@akitemquiz

# ─── AI via LiteLLM gateway (OpenAI-compatible) ───
AI_MODEL=cloud/auto
AI_TIMEOUT_MS=600000
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_KEY=sk-...

# ─── CRITICAL: Whisper ASR service endpoint (HTTP) ───
# REQUIRED: Point to a running faster-whisper service
# Local Docker: http://localhost:8000
# Kubernetes: http://whisper:8000 or http://faster-whisper-service:8000
# Without this, transcription will fail and block the entire pipeline!
WHISPER_BASE_URL=http://localhost:8000
WHISPER_REQUEST_TIMEOUT_MS=600000

# ─── Legacy (IGNORED): Whisper local model — pipeline only supports remote HTTP endpoint ───
# WHISPER_MODEL=tiny
# WHISPER_USE_GPU=false
# WHISPER_CPU_THREADS=4

# ─── Telegram Bot Token ───
TELEGRAM_BOT_TOKEN=123456:ABC-121212

# ─── Telegram Chat ID (channel or group) ───
TELEGRAM_CHAT_ID=-1001234567890

# ─── Watermark text for generated shorts ───
WATERMARK_TEXT="santidade católica"

# ─── Speaker-centered framing ───
# When "true" (default), the vertical crop is biased toward the main speaker's
# face (requires Python + opencv-python; falls back to a centered crop when
# unavailable). Set to "false" to always center-crop.
SPEAKER_FOCUS=true

# ─── Output Directory for generated shorts ───
OUTPUT_DIR=./output

# ─── Maximum short duration in seconds (default: 59) ───
MAX_SHORT_DURATION=59

# ─── Minimum short duration in seconds (default: 15) ───
MIN_SHORT_DURATION=15

# ─── Server port (for web UI API) ───
PORT=3001

# ─── Specific video URLs to process (comma-separated, optional) ───
# VIDEO_URLS=https://www.youtube.com/watch?v=xxx,https://www.youtube.com/watch?v=yyy

# ─── YouTube Cookies Configuration (To bypass bot protection) ───
# Extract cookies from browser: chrome, firefox, edge, opera, safari, brave
# YOUTUBE_COOKIES_BROWSER=chrome
# Or extract to a text file using an extension like Get cookies.txt LOCALLY:
# YOUTUBE_COOKIES_FILE=./cookies.txt

# ─── Shortcut for runPipeline total target of short clips ───
# TARGET_SHORTS=15

# ─── Shortcut for generate:top to publish multiple full videos ───
# FULL_VIDEO_COUNT=5

# ─── Comic-narration shorts (`pnpm cli generate:comic`) ───
# Requires Python + the `edge-tts` package (pip install edge-tts).
# Voice list: `edge-tts --list-voices`
# COMIC_TTS_VOICE=pt-BR-AntonioNeural
# Optional watermark text burned onto comic shorts (none by default):
# COMIC_WATERMARK_TEXT="seu canal"

# ─── Captions / framing / audio ───
# Karaoke sweep per word (default) or legacy one-word highlight:
# SUBTITLE_STYLE=karaoke
# Pan the vertical crop between speakers (needs opencv-python<5); false = static focus:
# SPEAKER_TRACKING=true
# Breathing zoom (+7% / 8s) for static single-speaker footage; off by default
# PUNCH_IN=false
# Royalty-free background music, ducked under the speech (one file or a random file from a folder):
# BGM_FILE=./assets/music/track.mp3
# BGM_DIR=./assets/music
# BGM_VOLUME=0.18

# ─── Clip analysis (Opus-style) ───
# VIDEO_GENRE=podcast        # podcast|qa|vlog|listicle|webinar|sermon|gaming|sports|news|comedy
# CLIP_PROMPT="momentos engraçados sobre dinheiro"
# BRAND_VOCABULARY=Kubernetes,LiteLLM   # or BRAND_VOCABULARY_FILE=./terms.txt

# ─── Overlays / editing ───
# CAPTION_FONT="Poppins ExtraBold"   # any family in assets/fonts or installed
# CTA_TEXT="Siga para mais"   # closing call to action (empty = off)
# HOOK_OVERLAY=true           # title card in the first seconds
# LOWER_THIRD=true            # presenter name tag
# BRAND_TEMPLATES_DIR=./brand-templates   # default.json + <channel-slug>.json
# SILENCE_CUT=true            # cut long pauses and filler words
# AUTO_CROP=true              # crop baked-in black bars
# SPEECH_DENOISE=true
# BROLL=true
# BROLL_DIR=./assets/broll    # files named after what they show, e.g. city-night.mp4
# BROLL_SECONDS=2.6
# BROLL_MAX=3

# ─── Publishing to other platforms (queued to PEAK_HOURS, drained by `queue:process`) ───
# TITLE_STYLE=curious         # catchy|curious|serious|question
# PUBLISH_PLATFORMS=bluesky,instagram,threads,tiktok,pinterest   # default: every platform with credentials
# PEAK_HOURS=12,18,21
# PUBLISH_TZ=America/Sao_Paulo
# SOCIAL_SCHEDULE=true        # false = post at the next queue:process
# BLUESKY_HANDLE= / BLUESKY_APP_PASSWORD=
# INSTAGRAM_USER_ID= / INSTAGRAM_ACCESS_TOKEN=    # needs SERVER_PUBLIC_URL
# THREADS_USER_ID= / THREADS_ACCESS_TOKEN=        # needs SERVER_PUBLIC_URL
# TIKTOK_ACCESS_TOKEN= / TIKTOK_PRIVACY=SELF_ONLY # needs SERVER_PUBLIC_URL (verified domain)
# PINTEREST_ACCESS_TOKEN= / PINTEREST_BOARD_ID=

# ─── Faceless shorts (`pnpm cli generate:faceless --topic "..."`) ───
# Stock footage from https://www.pexels.com/api/ (plain color cards when unset):
# PEXELS_API_KEY=

# ─── Max YouTube uploads per calendar day per channel (default: 4) ───
# Posting floods (10+/day) collapse Shorts distribution channel-wide.
MAX_DAILY_UPLOADS=4

# ─── Max uploads per queue-process run, across channels (default: unlimited) ───
# Set (e.g. 2) with multiple daily cron slots so posts are spaced hours apart.
# MAX_UPLOADS_PER_RUN=2

# ─── Keep temp files (audio + video sections) after processing — useful for debugging ───
# KEEP_TEMP_FILES=true

# ─── Skip remote video file-size check (safe when using audio-only download) ───
# SKIP_VIDEO_SIZE_CHECK=true

# ─── Maximum video duration to include from channel listings (in hours, default: 1) ───
# MAX_VIDEO_DURATION_HOURS=1
