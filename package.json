{
  "name": "shorts-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Automated YouTube Shorts generator — downloads videos, transcribes with Whisper, identifies viral moments via LLM, generates vertical shorts with captions, and sends to Telegram.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "cli": "tsx src/cli.ts",
    "generate": "tsx src/cli.ts generate",
    "generate:top": "tsx src/cli.ts generate:top",
    "generate:url": "tsx src/cli.ts generate --url",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit",
    "web:dev": "pnpm --dir web run dev",
    "web:build": "pnpm --dir web run build",
    "web:preview": "pnpm --dir web run preview",
    "typecheck": "tsc --noEmit",
    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@hono/node-server": "^1.13.0",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "ai": "^6.0.140",
    "ai-sdk-ollama": "^3.8.3",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "glob": "^11.0.0",
    "googleapis": "^171.4.0",
    "grammy": "^1.31.0",
    "hono": "^4.6.0",
    "nanoid": "^5.0.9",
    "ollama-ai-provider": "^1.2.0",
    "p-limit": "^6.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
