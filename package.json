{
  "name": "shorts-generator",
  "version": "1.0.136",
  "private": true,
  "description": "Automated YouTube Shorts generator — downloads videos, transcribes with Whisper, identifies viral moments via LLM, generates vertical shorts with captions, and sends to Telegram.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "cli": "tsx src/cli.ts",
    "queue:process": "tsx src/cli.ts queue:process",
    "generate": "tsx src/cli.ts generate",
    "generate:top": "tsx src/cli.ts generate:top",
    "generate:quiz": "tsx src/cli.ts generate:quiz",
    "generate:url": "tsx src/cli.ts generate --url",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:youtube-health": "vitest run tests/core/youtube.health.ts",
    "build": "node scripts/typecheck.cjs",
    "web:dev": "pnpm --dir web run dev",
    "web:build": "pnpm --dir web run build",
    "web:preview": "pnpm --dir web run preview",
    "typecheck": "tsc --noEmit",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "bootstrap:control-plane": "tsx scripts/bootstrap-control-plane.ts",
    "diagnose:cluster": "tsx scripts/diagnose-cluster.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.2",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@hono/node-server": "^2.0.4",
    "ai": "^6.0.140",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.79.2",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "glob": "^13.0.6",
    "googleapis": "^172.0.0",
    "grammy": "^1.31.0",
    "hono": "^4.12.27",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.16",
    "ollama-ai-provider": "^1.2.0",
    "p-limit": "^7.3.0",
    "pg": "8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
