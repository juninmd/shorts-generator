{
  "name": "shorts-generator",
  "version": "1.0.136",
  "private": true,
  "description": "Automated YouTube Shorts generator — downloads videos, transcribes with Whisper, identifies viral moments via LLM, generates vertical shorts with captions, and sends to Telegram.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "cli": "bun src/cli.ts",
    "queue:process": "bun src/cli.ts queue:process",
    "generate": "bun src/cli.ts generate",
    "generate:top": "bun src/cli.ts generate:top",
    "generate:quiz": "bun src/cli.ts generate:quiz",
    "generate:metrics-digest": "bun src/cli.ts generate:metrics-digest",
    "generate:url": "bun src/cli.ts generate --url",
    "test": "bun --bun run vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:youtube-health": "vitest run tests/core/youtube.health.ts",
    "build": "node scripts/typecheck.cjs",
    "web:dev": "bun --cwd web run dev",
    "web:build": "bun --cwd web run build",
    "web:preview": "bun --cwd web run preview",
    "typecheck": "tsc --noEmit",
    "smoke-test": "bun scripts/smoke-test.ts",
    "bootstrap:control-plane": "bun scripts/bootstrap-control-plane.ts",
    "diagnose:cluster": "bun scripts/diagnose-cluster.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@hono/node-server": "^2.1.11",
    "ai": "^7.0.177",
    "better-sqlite3": "^13.1.1",
    "bullmq": "^6.7.8",
    "dotenv": "^18.0.10",
    "googleapis": "190.0.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.19",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.2",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "workspaces": [
    "web"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "msgpackr-extract"
  ]
}
